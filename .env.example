# BrowserSilo local Docker Compose setup (Node.js 24+ and Docker required).
# Copy this file to .env before running make images and make up.
# Compose loads .env automatically; native node/npm commands do not.
# These are public, local-development defaults, not production credentials.
# Keep the loopback binding. Replace all tokens before any non-local deployment.

# Host ports. Change these if another local app already uses them.
BROWSERSILO_BIND_ADDRESS=127.0.0.1
BROWSERSILO_BROWSER_PORT=4100
BROWSERSILO_ADMIN_PORT=4101

# Public development tokens: Admin UI, agent API/MCP, and private worker manager.
BROWSERSILO_ADMIN_TOKEN=admin-local-development-token
BROWSERSILO_AGENT_TOKEN=agent-local-development-token
BROWSERSILO_WORKER_MANAGER_TOKEN=local-worker-manager-token-change-me

# Start browsers on demand; no idle Brave workers for a lightweight first test.
BROWSERSILO_WARM_SHELLS=0
BROWSERSILO_MAX_ACTIVE=4
BROWSERSILO_MAX_ACTIVE_PER_TENANT=2
BROWSERSILO_ADMISSION_TIMEOUT_MS=30000

# Stable names for the local Compose project and its persistent data volume.
# A separate installation needs distinct project/run IDs and host ports.
# Keep the run ID unchanged to keep using the same saved browser identities.
BROWSERSILO_COMPOSE_PROJECT=browsersilo
BROWSERSILO_RUN_ID=local

# Optional base64-encoded 32-byte profile/artifact master key.
# Blank generates a unique local key in the persistent data volume.
# Never commit a real key or replace an existing key to rotate it.
BROWSERSILO_DATA_KEY=

# Optional multi-principal JSON configuration. Blank uses the local agent token.
# See docs/integration.md for authentication details; do not commit real tokens.
BROWSERSILO_PRINCIPALS_JSON=
